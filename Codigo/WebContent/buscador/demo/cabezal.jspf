<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%!
    /**
     * Escape de atributos para el buscador del cabezal.
     *
     * <p>Se declara con un nombre propio (y no como htmlEscape) porque este
     * .jspf se incluye de forma estatica: si la pagina que lo incluye ya
     * declara htmlEscape, dos metodos con la misma firma romperian la
     * traduccion de la JSP.</p>
     */
    private String htmlEscapeCabezal(String value) {
        if (value == null) {
            return "";
        }

        StringBuilder escaped = new StringBuilder(value.length() + 16);
        for (int i = 0; i < value.length(); i++) {
            char c = value.charAt(i);
            switch (c) {
                case '&': escaped.append("&amp;"); break;
                case '<': escaped.append("&lt;"); break;
                case '>': escaped.append("&gt;"); break;
                case '"': escaped.append("&quot;"); break;
                case '\'': escaped.append("&#39;"); break;
                default: escaped.append(c);
            }
        }
        return escaped.toString();
    }
%>
<%
    // Valores del buscador del cabezal. Se resuelven aqui (y no se toman de
    // variables de la pagina que incluye) porque el include es estatico y
    // ocurre antes que los scriptlets de busqueda.jsp. Se leen los mismos
    // atributos que publica el servlet, con los mismos valores por defecto.
    String qCabezal = (String) request.getAttribute("q");
    String tipoCabezal = (String) request.getAttribute("tipo");
    Integer paginaCabezalAttr = (Integer) request.getAttribute("pagina");
    qCabezal = qCabezal == null ? "" : qCabezal;
    tipoCabezal = tipoCabezal == null ? "" : tipoCabezal;
    int paginaCabezal = paginaCabezalAttr == null ? 1 : paginaCabezalAttr.intValue();
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Sitio web demo</title>
        <link rel="stylesheet" href="<%= request.getContextPath() %>/buscador/demo/estilos.css">
    <script>
    (function () {
        function inicializarCargaBuscador() {
            var form = document.getElementById("formBusqueda");
            var estadoCarga = document.getElementById("estadoCarga");
            var input = document.getElementById("qInput");
            var boton = document.getElementById("btnBuscar");

            if (!form || !estadoCarga || !input || !boton) {
                return;
            }

            function finalizarCarga() {
                estadoCarga.hidden = true;
                input.disabled = false;
                boton.disabled = false;
            }

            form.addEventListener("submit", function () {
                if (!form.checkValidity()) {
                    return;
                }

                estadoCarga.hidden = false;
                input.readOnly = true;
                boton.disabled = true;
            });

            window.addEventListener("pageshow", finalizarCarga);
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                inicializarCargaBuscador
            );
        } else {
            inicializarCargaBuscador();
        }
    })();
    
        (function () {
            function formBusqueda() {
                return document.getElementById('formBusqueda');
            }

            function setLoading() {
                var form = formBusqueda();
                var estado = document.getElementById('estadoCarga');
                if (form) {
                    form.setAttribute('aria-busy', 'true');
                }
                if (estado) {
                    estado.hidden = false;
                }
            }

            function navegar(numPagina) {
                var inputPagina = document.getElementById('paginaInput');
                var form = formBusqueda();
                if (!inputPagina || !form) {
                    return;
                }

                inputPagina.value = numPagina;
                setLoading();
                form.submit();
            }

            function aplicarFiltro(codigoTipo) {
                var inputTipo = document.getElementById('tipoInput');
                var inputPagina = document.getElementById('paginaInput');
                var form = formBusqueda();
                if (!inputTipo || !inputPagina || !form) {
                    return;
                }

                inputTipo.value = codigoTipo || '';
                inputPagina.value = '1';
                setLoading();
                form.submit();
            }

            document.addEventListener('DOMContentLoaded', function () {
                var form = formBusqueda();
                if (form) {
                	form.addEventListener("submit", function () {
                	    if (typeof form.checkValidity === "function"
                	            && !form.checkValidity()) {
                	        return;
                	    }
                	    // estadoCarga puede no existir (p. ej. inicio.jsp tambien
                	    // incluye el cabezal y no tiene el overlay de resultados).
                	    var estado = document.getElementById('estadoCarga');
                	    if (estado) {
                	        estado.hidden = false;
                	    }
                	    window.scrollTo({
                	        top: 0,
                	        behavior: "auto"
                	    });
                	});
                }

                var controlesPagina = document.querySelectorAll('.pagina-control');
                for (var i = 0; i < controlesPagina.length; i++) {
                    controlesPagina[i].addEventListener('click', function () {
                        navegar(parseInt(this.getAttribute('data-pagina'), 10));
                    });
                }

                var filtros = document.querySelectorAll('.filtro-item');
                for (var j = 0; j < filtros.length; j++) {
                    filtros[j].addEventListener('click', function () {
                        aplicarFiltro(this.getAttribute('data-tipo'));
                    });
                }
            });
        })();
    </script>
</head>
<body>
    <header class="header">
        <p class="header-titulo">Nombre del sitio</p>
        <nav aria-label="Menú de navegación principal">
            Menú de navegación principal (Inicio, Acerca de, Contacto)
        </nav>

        <search>
            <form id="formBusqueda"
                  class="search-form"
                  action="<%= request.getContextPath() %>/buscar"
                  method="GET"
                  role="search"
                  autocomplete="off">
                <label for="qInput">Buscar contenidos</label>
                <input type="search"
                       name="q"
                       id="qInput"
                       value="<%= htmlEscapeCabezal(qCabezal) %>"
                       placeholder="Ingrese sus términos de búsqueda..."
                       aria-label="Buscar contenidos"
                       aria-describedby="sugerenciasInfo"
                       autocomplete="off"
                       required />
                <input type="hidden" name="tipo" id="tipoInput" value="<%= htmlEscapeCabezal(tipoCabezal) %>" />
                <input type="hidden" name="pagina" id="paginaInput" value="<%= paginaCabezal %>" />
                <button type="submit" id="btnBuscar">Buscar</button>
                <p id="sugerenciasInfo" class="visually-hidden">
                    Empiece a escribir para ver sugerencias de búsqueda.
                </p>
            </form>
        </search>
    </header>
